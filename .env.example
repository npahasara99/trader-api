# Core app
DATABASE_URL=sqlite:///./local.db
SUPABASE_DATABASE_URL=
OPENAI_API_KEY=
API_BEARER_TOKEN=
TRADINGVIEW_WEBHOOK_SECRET=
ENV=prod

# Dashboard / API
TRADER_API_PORT=8080
TRADER_API_BASE_URL=http://127.0.0.1:8080
TRADER_API_TIMEOUT_SECONDS=180

# Trading bot safety defaults
TRADING_MODE=disabled
AUTO_EXECUTION=false

IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=21
IBKR_ACCOUNT_ID=
IBKR_REQUIRE_PAPER_ACCOUNT=true
# Keep true until the TWS paper account and reconciliation are verified.
IBKR_READ_ONLY=true
IBKR_RECONNECT_ENABLED=true

TRADING_BUDGET=10000
MAX_CAPITAL_UTILIZATION_PCT=70
RISK_PER_TRADE_PCT=0.75
MAX_POSITION_PCT=20
MAX_OPEN_POSITIONS=8
MAX_PORTFOLIO_RISK_PCT=4
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
MIN_REWARD_RISK=2
MAX_SECTOR_EXPOSURE_PCT=35

ALLOW_SHORTS=false
ALLOW_EXTENDED_HOURS=false
NEW_ENTRY_START_TIME=10:00
NEW_ENTRY_END_TIME=15:30
MAX_HOLDING_DAYS=15
AUTO_CLOSE_BEFORE_EARNINGS=true
EARNINGS_EXIT_DAYS=1

CANCEL_UNFILLED_AFTER_MINUTES=30
MAX_SLIPPAGE_PCT=0.5
MAX_SPREAD_PCT=0.75
STALE_QUOTE_SECONDS=60

BOT_SCAN_INTERVAL_SECONDS=900
BOT_TRIGGER_CHECK_INTERVAL_SECONDS=300
BOT_POSITION_MONITOR_INTERVAL_SECONDS=60
BOT_RECONCILE_INTERVAL_SECONDS=60

# Advisory-only live swing monitor. No broker orders are submitted by this service.
LIVE_MONITOR_ENABLED=true
LIVE_MONITOR_POLL_SECONDS=60
LIVE_MONITOR_STALE_SECONDS=180
LIVE_MONITOR_NEAR_TRIGGER_PCT=0.005
LIVE_MONITOR_VOLUME_LOOKBACK_BARS=20
LIVE_MONITOR_CONSTRUCTIVE_RVOL=1.20
LIVE_MONITOR_STRONG_RVOL=1.50
LIVE_MONITOR_MAX_UPPER_WICK_RATIO=0.35
LIVE_MONITOR_MIN_CLOSE_LOCATION=0.60
LIVE_MONITOR_MIN_CURRENT_RR=1.25
LIVE_MONITOR_MAX_CHASE_PCT=0.005
LIVE_MONITOR_MAX_CHASE_ATR_FRACTION=0.35
LIVE_MONITOR_RETEST_ATR_FRACTION=0.15
LIVE_MONITOR_AUTO_LLM_MIN_SCORE=8.0
LIVE_MONITOR_LEARNING_MIN_OBSERVATIONS=12
LIVE_MONITOR_TRIGGER_MAX_ATR=3.0
LIVE_MONITOR_TRIGGER_MAX_RANGE_FRACTION=0.65
LIVE_MONITOR_CHART_MAX_STOP_ATR=3.5
LIVE_MONITOR_CHART_MAX_TARGET_ATR=5.0
LIVE_MONITOR_PLAN_MAX_AGE_DAYS=15
LIVE_MONITOR_SOURCE_PLAN_MAX_AGE_MINUTES=120
LIVE_MONITOR_PLAN_PRICE_DRIFT_PCT=0.03
LIVE_MONITOR_PLAN_PRICE_DRIFT_ATR=1.50
LIVE_MONITOR_SUPPORT_FAILURE_ATR=0.35
LIVE_MONITOR_MAJOR_GAP_ATR=1.50
LIVE_MONITOR_NEW_STRUCTURE_LOOKBACK_BARS=12
LIVE_MONITOR_MARKET_DATA_MISMATCH_PCT=0.0125
LIVE_MONITOR_MARKET_DATA_MISMATCH_ATR_FRACTION=0.50
LIVE_MONITOR_AUTO_PROPOSE_REANALYSIS_ON_STALE=true
LIVE_MONITOR_FRONTEND_REFRESH_SECONDS=5
LIVE_MONITOR_CHART_REVIEW_ON_ADD=true
LIVE_MONITOR_CHART_REVIEW_MODEL=gpt-5
LIVE_MONITOR_CHART_REVIEW_COOLDOWN_SECONDS=900
LIVE_MONITOR_MAX_AUTO_CHART_REVIEWS_PER_DAY=3
LIVE_MONITOR_CHART_SNAPSHOT_DIR=chart_snapshots
LIVE_MONITOR_CHART_MAX_BARS=180
LIVE_MONITOR_CHART_RETENTION_DAYS=90

# Live trading remains locked until every control below is explicitly enabled.
LIVE_TRADING_UNLOCKED=false
LIVE_TRADING_CONFIRMATION=
LIVE_MAX_BUDGET=0
LIVE_MAX_OPEN_POSITIONS=1
