# Core app
DATABASE_URL=sqlite:///./local.db
SUPABASE_DATABASE_URL=
OPENAI_API_KEY=
API_BEARER_TOKEN=
TRADINGVIEW_WEBHOOK_SECRET=
ENV=prod

# Dashboard / API
TRADER_API_PORT=8080
TRADER_API_BASE_URL=http://127.0.0.1:8080
TRADER_API_TIMEOUT_SECONDS=180

# Trading bot safety defaults
TRADING_MODE=disabled
AUTO_EXECUTION=false

IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=21
IBKR_ACCOUNT_ID=
IBKR_REQUIRE_PAPER_ACCOUNT=true
# Keep true until the TWS paper account and reconciliation are verified.
IBKR_READ_ONLY=true
IBKR_RECONNECT_ENABLED=true

TRADING_BUDGET=10000
MAX_CAPITAL_UTILIZATION_PCT=70
RISK_PER_TRADE_PCT=0.75
MAX_POSITION_PCT=20
MAX_OPEN_POSITIONS=8
MAX_PORTFOLIO_RISK_PCT=4
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
MIN_REWARD_RISK=2
MAX_SECTOR_EXPOSURE_PCT=35

ALLOW_SHORTS=false
ALLOW_EXTENDED_HOURS=false
NEW_ENTRY_START_TIME=10:00
NEW_ENTRY_END_TIME=15:30
MAX_HOLDING_DAYS=15
AUTO_CLOSE_BEFORE_EARNINGS=true
EARNINGS_EXIT_DAYS=1

CANCEL_UNFILLED_AFTER_MINUTES=30
MAX_SLIPPAGE_PCT=0.5
MAX_SPREAD_PCT=0.75
STALE_QUOTE_SECONDS=60

BOT_SCAN_INTERVAL_SECONDS=900
BOT_TRIGGER_CHECK_INTERVAL_SECONDS=300
BOT_POSITION_MONITOR_INTERVAL_SECONDS=60
BOT_RECONCILE_INTERVAL_SECONDS=60

# Live trading remains locked until every control below is explicitly enabled.
LIVE_TRADING_UNLOCKED=false
LIVE_TRADING_CONFIRMATION=
LIVE_MAX_BUDGET=0
LIVE_MAX_OPEN_POSITIONS=1
