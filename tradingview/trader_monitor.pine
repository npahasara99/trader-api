//@version=6
indicator("Trader API Watchlist Monitor", shorttitle = "Trader Monitor", overlay = true)

// Enter a dedicated, low-scope webhook secret in indicator settings. The
// committed source intentionally contains no credential.
string webhookSecret = input.string("", "Webhook secret", group = "Webhook", tooltip = "Must match TRADINGVIEW_WEBHOOK_SECRET. Never use a broker or account password.")
bool webhookEnabled = input.bool(true, "Enable webhook alerts", group = "Webhook")

int localLookback = input.int(20, "Local range lookback", minval = 5, maxval = 100, group = "Signal Settings")
float supportLevel = input.float(0.0, "Monitored support (0 = automatic local low)", minval = 0.0, group = "Signal Settings")
float breakoutLevel = input.float(0.0, "Monitored breakout level (0 = automatic local high)", minval = 0.0, group = "Signal Settings")
float levelTolerancePct = input.float(0.35, "Level tolerance %", minval = 0.05, maxval = 3.0, step = 0.05, group = "Signal Settings") / 100.0

float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema100 = ta.ema(close, 100)
float ema200 = ta.ema(close, 200)
float rsi14 = ta.rsi(close, 14)
float atr14 = ta.atr(14)
float averageVolume = ta.sma(volume, 20)
float relativeVolume = averageVolume > 0 ? volume / averageVolume : na
float automaticLocalHigh = ta.highest(high, localLookback)[1]
float automaticLocalLow = ta.lowest(low, localLookback)[1]
float activeSupport = supportLevel > 0 ? supportLevel : automaticLocalLow
float activeBreakout = breakoutLevel > 0 ? breakoutLevel : automaticLocalHigh

string jsonNumber(float value) =>
    na(value) ? "null" : str.tostring(value, format.mintick)

string jsonEscape(string value) =>
    str.replace_all(str.replace_all(value, "\\", "\\\\"), "\"", "\\\"")

sendEvent(string eventType) =>
    string eventTime = str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    string message = "{" +
      "\"secret\":\"" + jsonEscape(webhookSecret) + "\"," +
      "\"ticker\":\"" + jsonEscape(syminfo.ticker) + "\"," +
      "\"timeframe\":\"" + jsonEscape(timeframe.period) + "\"," +
      "\"event_type\":\"" + eventType + "\"," +
      "\"price\":" + jsonNumber(close) + "," +
      "\"event_time\":\"" + eventTime + "\"," +
      "\"ema20\":" + jsonNumber(ema20) + "," +
      "\"ema50\":" + jsonNumber(ema50) + "," +
      "\"ema100\":" + jsonNumber(ema100) + "," +
      "\"ema200\":" + jsonNumber(ema200) + "," +
      "\"rsi\":" + jsonNumber(rsi14) + "," +
      "\"atr\":" + jsonNumber(atr14) + "," +
      "\"volume\":" + jsonNumber(volume) + "," +
      "\"relative_volume\":" + jsonNumber(relativeVolume) + "," +
      "\"local_high\":" + jsonNumber(automaticLocalHigh) + "," +
      "\"local_low\":" + jsonNumber(automaticLocalLow) + "}"
    alert(message, alert.freq_once_per_bar_close)

bool supportHold = not na(activeSupport) and low <= activeSupport * (1.0 + levelTolerancePct) and close >= activeSupport and close > open
bool supportBreak = not na(activeSupport) and ta.crossunder(close, activeSupport)
bool ema20Reclaim = ta.crossover(close, ema20)
bool ema50Reclaim = ta.crossover(close, ema50)
bool breakout = not na(activeBreakout) and ta.crossover(close, activeBreakout)
bool breakoutFailure = not na(activeBreakout) and ta.crossunder(close, activeBreakout) and ta.barssince(breakout) <= 10
bool momentumImproving = ta.crossover(rsi14, 50) and close > ema20
bool momentumWeakening = ta.crossunder(rsi14, 50) and close < ema20
bool rsiRecovery = ta.crossover(rsi14, 40)
bool rsiOverextended = ta.crossover(rsi14, 70)

bool canAlert = webhookEnabled and webhookSecret != "" and barstate.isconfirmed
if canAlert
    if supportHold
        sendEvent("SUPPORT_HOLD")
    if supportBreak
        sendEvent("SUPPORT_BREAK")
    if ema20Reclaim
        sendEvent("EMA20_RECLAIM")
    if ema50Reclaim
        sendEvent("EMA50_RECLAIM")
    if breakout
        sendEvent("BREAKOUT")
    if breakoutFailure
        sendEvent("BREAKOUT_FAILURE")
    if momentumImproving
        sendEvent("MOMENTUM_IMPROVING")
    if momentumWeakening
        sendEvent("MOMENTUM_WEAKENING")
    if rsiRecovery
        sendEvent("RSI_RECOVERY")
    if rsiOverextended
        sendEvent("RSI_OVEREXTENDED")

plot(ema20, "EMA 20", color = color.new(color.teal, 0), linewidth = 2)
plot(ema50, "EMA 50", color = color.new(color.blue, 0), linewidth = 2)
plot(ema100, "EMA 100", color = color.new(color.orange, 10))
plot(ema200, "EMA 200", color = color.new(color.red, 10))
plot(activeSupport, "Active support", color = color.new(color.green, 20), style = plot.style_linebr)
plot(activeBreakout, "Active breakout", color = color.new(color.yellow, 20), style = plot.style_linebr)

plotshape(supportHold, "Support hold", shape.circle, location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(supportBreak, "Support break", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny)
plotshape(breakout, "Breakout", shape.triangleup, location.belowbar, color.new(color.aqua, 0), size = size.tiny)
plotshape(breakoutFailure, "Breakout failure", shape.xcross, location.abovebar, color.new(color.orange, 0), size = size.tiny)
